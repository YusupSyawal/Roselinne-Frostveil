# ──────────────────────────────────────────────────────────
#  Roselinne Frostveil — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Discord ────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# ── (Optional) Sync slash commands to one guild only during dev
# TEST_GUILD_ID=your_test_guild_id_here

# Optional fallback channels for member welcome/leave messages.
# Runtime /welcomechannel and /leavechannel settings take precedence.
# WELCOME_CHANNEL_ID=
# LEAVE_CHANNEL_ID=

# ── AI Provider ────────────────────────────────────────────
# Supported: openai | groq | ollama
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq (alternative — fast & free tier)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Ollama (local AI — no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Bot Behaviour ──────────────────────────────────────────
# Max messages kept per user in memory
MEMORY_MAX_MESSAGES=20

# Seconds a user must wait between /chat calls
COOLDOWN_SECONDS=5

# Max tokens per AI response
MAX_TOKENS=1000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# AI starts OFF until /ai_on is used in each server.
# Runtime state is stored in data/runtime_state.json.
